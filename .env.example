# CheburSpeed environment template — copy to `.env` and fill in real values.

# --- Database ------------------------------------------------------------
POSTGRES_USER=xspeed
POSTGRES_PASSWORD=xspeed
POSTGRES_DB=xspeed
DATABASE_URL=postgresql+asyncpg://xspeed:xspeed@localhost:5432/xspeed

# --- Auth ----------------------------------------------------------------
# 32+ random characters in production.
JWT_SECRET=change-me-please-change-me-please-change-me
JWT_ALGORITHM=HS256

# --- Network -------------------------------------------------------------
# Public WebSocket URL advertised to probes.
WS_HOST=ws://localhost:8000/ws

# CORS allowed origin for the SvelteKit frontend.
FRONTEND_ORIGIN=http://localhost:5173

# --- Runtime -------------------------------------------------------------
LOG_LEVEL=INFO

# --- Rate limits (per client IP) ------------------------------------------
RATE_LIMIT_TASK_CREATE_PER_HOUR=100
RATE_LIMIT_TASK_READ_PER_MINUTE=1000
RATE_LIMIT_TASK_LIST_PER_MINUTE=1000
RATE_LIMIT_ADMIN_LOGIN_PER_MINUTE=100

# --- nginx ---------------------------------------------------------------
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443