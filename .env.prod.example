# Production environment template. Copy to .env.prod and fill in real
# values before bringing up docker-compose.prod.yml.

# --- Image tag ---------------------------------------------------------
# Pin to a release tag in production (e.g. 0.1.0) instead of :latest.
GITHUB_REPOSITORY_OWNER=gorcer
XSPEED_VERSION=latest

# --- Database ---------------------------------------------------------
POSTGRES_USER=xspeed
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=xspeed

# --- Auth -------------------------------------------------------------
# 32+ random characters. Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-32-bytes-of-random-data-aaaaaaaaaa
JWT_ALGORITHM=HS256

# --- Network ----------------------------------------------------------
# Public WebSocket URL advertised to probes.
WS_HOST=wss://xspeed.example.com/ws
# CORS origin for the SvelteKit frontend.
FRONTEND_ORIGIN=https://xspeed.example.com

# --- Runtime ----------------------------------------------------------
LOG_LEVEL=INFO

# --- nginx / TLS ------------------------------------------------------
# Hostname certificates are issued for. REQUIRED for certbot.
NGINX_SERVER_NAME=xspeed.example.com
# Email for Let's Encrypt notifications.
CERTBOT_EMAIL=ops@example.com
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
