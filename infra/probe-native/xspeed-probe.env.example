# CheburSpeed probe configuration — native (Docker-less) install.
#
# Copy to /etc/xspeed-probe.env, fill in PROBE_TOKEN, then chmod 0600:
#
#   sudo install -m 0600 xspeed-probe.env.example /etc/xspeed-probe.env
#   sudo $EDITOR /etc/xspeed-probe.env
#
# The variable names match the ones the Docker image takes, so a host
# can be migrated between the two deployment styles without changing
# the probe itself.

# Production WebSocket endpoint of the server. Must be wss:// — the
# bearer token would travel in clear text over ws://.
SERVER_URL=wss://che.dataforest.app/ws

# Bearer token of the probe, registered server-side via
# POST /api/v1/admin/probes (alias + region_id). The server rejects
# the WebSocket handshake with HTTP 403 when the token is unknown.
PROBE_TOKEN=replace-me

# Human-readable name of the probe (shown in /admin/probes).
PROBE_ALIAS=orenburg

# Region code from the server-side `regions` catalogue — RU-ORE is
# Оренбургская область.
REGION_CODE=RU-ORE

# Default speedtest target; a task's own destination overrides it.
SPEEDTEST_URL=https://speed.cloudflare.com/__down?bytes=10000000

LOG_LEVEL=INFO
