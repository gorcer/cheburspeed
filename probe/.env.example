# Probe environment template — copy to `probe/.env` and fill in real values.

# --- Connection --------------------------------------------------------
# WebSocket endpoint exposed by the CheburSpeed server (without trailing slash).
SERVER_URL=ws://server:8080/ws

# Bearer token used to authenticate against /ws. MUST match the
# `probes.token` column populated by the server admin / registration
# API. There is no token-issuance endpoint yet — tokens are inserted
# directly into the database for now.
PROBE_TOKEN=replace-with-token

# --- Identity ----------------------------------------------------------
# Human-readable name shown on the map and in logs.
PROBE_ALIAS=home-router-1

# Region code matching `regions.code` in the server database. The server
# resolves it back to a region_id on every `online` handshake so changing
# this env var and restarting the probe is enough to relocate it.
REGION_CODE=msk

# Optional outbound network interface. If set but not present on the
# host, or present but without a routable IPv4, the probe logs a
# warning and silently skips the task (no result frame is sent); the
# server-side sweeper recycles the task back into the queue after
# 5 minutes.
NETWORK_INTERFACE=

# --- Speedtest ---------------------------------------------------------
# Target URL for the throughput measurement. The default is Cloudflare's
# 100 MB download endpoint (no API key, supports HTTP/2 + range).
SPEEDTEST_URL=https://speed.cloudflare.com/__down?bytes=100000000

# --- Runtime -----------------------------------------------------------
LOG_LEVEL=INFO